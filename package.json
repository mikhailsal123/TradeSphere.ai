{
  "name": "tradesphere-fullstack",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "cd frontend && npm install && npm run build",
    "start": "npm run frontend:start",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:start": "cd frontend && npm start",
    "backend:dev": "FLASK_ENV=development FLASK_PORT=5002 python3 flask_backend.py",
    "backend:start": "python3 flask_backend.py"
  }
}
